name: Build and release (no web tabs)

# Checks once a day whether mjonuschat/PrusaSlicer has a new STABLE release tag
# (version_X.Y.Z+boss, no -rc/-beta/nightly). If one has not been built here yet,
# the builds run ONE AT A TIME (so the Actions cache never holds two big
# dependency builds at once), then everything is published as one GitHub Release.
#
# To switch a build off without editing files, set a repository variable
# (Settings -> Secrets and variables -> Actions -> Variables) to the value false:
#   BUILD_LINUX_X86_64   BUILD_LINUX_AARCH64   BUILD_WINDOWS   BUILD_MACOS
# To add a platform later, add another job below, after the last build, and add
# it to the needs lists of `publish` and `notify_failure`.

on:
  schedule:
    - cron: "17 5 * * *"
  workflow_dispatch:
    inputs:
      tag:
        description: "Upstream tag to build, e.g. version_2.9.7+boss (blank = newest stable)"
        required: false
        default: ""

permissions:
  contents: read

env:
  UPSTREAM_REPO: mjonuschat/PrusaSlicer

jobs:
  check:
    name: Look for a new release
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: read
    outputs:
      tag: ${{ steps.pick.outputs.tag }}
      build: ${{ steps.pick.outputs.build }}
    steps:
      - name: Pick tag and decide whether to build
        id: pick
        env:
          GH_TOKEN: ${{ github.token }}
          INPUT_TAG: ${{ inputs.tag }}
        run: |
          set -euo pipefail
          if [ -n "${INPUT_TAG}" ]; then
            tag="${INPUT_TAG}"
          else
            tag=$(git ls-remote --tags "https://github.com/${UPSTREAM_REPO}.git" 'refs/tags/version_*+boss' \
              | awk '{print $2}' | sed 's#^refs/tags/##' \
              | grep -E '^version_[0-9]+\.[0-9]+\.[0-9]+\+boss$' \
              | sort -V | tail -n1)
          fi
          if [ -z "${tag}" ]; then
            echo "::error::No stable version_*+boss tag found upstream"
            exit 1
          fi
          echo "Newest stable upstream tag: ${tag}"
          echo "tag=${tag}" >> "$GITHUB_OUTPUT"

          build=true
          if [ -n "${INPUT_TAG}" ]; then
            echo "Manual run for ${tag}: rebuilding and re-uploading assets."
          elif gh release view "${tag}-nowebview" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            echo "Already built: ${tag}-nowebview exists."
            build=false
          else
            # Don't retry every day after a failure: an open failure issue pauses
            # the schedule for that tag. Close the issue or run manually to retry.
            open=$(gh issue list --repo "$GITHUB_REPOSITORY" --state open \
              --search "\"Build failed for ${tag}\" in:title" --json number --jq 'length' || echo 0)
            if [ "${open}" != "0" ]; then
              echo "An open failure issue exists for ${tag}; skipping."
              build=false
            fi
          fi
          echo "build=${build}" >> "$GITHUB_OUTPUT"

  build_linux_x86_64:
    name: Linux x86_64
    needs: check
    if: ${{ needs.check.outputs.build == 'true' && vars.BUILD_LINUX_X86_64 != 'false' }}
    uses: ./.github/workflows/build-linux.yml
    with:
      tag: ${{ needs.check.outputs.tag }}
      arch: x86_64

  build_linux_aarch64:
    name: Linux aarch64
    needs: [check, build_linux_x86_64]
    if: ${{ !cancelled() && needs.check.outputs.build == 'true' && vars.BUILD_LINUX_AARCH64 != 'false' }}
    uses: ./.github/workflows/build-linux.yml
    with:
      tag: ${{ needs.check.outputs.tag }}
      arch: aarch64

  build_windows:
    name: Windows
    needs: [check, build_linux_aarch64]
    # !cancelled() lets this run even if an earlier build failed or was switched off.
    if: ${{ !cancelled() && needs.check.outputs.build == 'true' && vars.BUILD_WINDOWS != 'false' }}
    uses: ./.github/workflows/build-windows.yml
    with:
      tag: ${{ needs.check.outputs.tag }}

  build_macos:
    name: macOS
    needs: [check, build_windows]
    if: ${{ !cancelled() && needs.check.outputs.build == 'true' && vars.BUILD_MACOS != 'false' }}
    uses: ./.github/workflows/build-macos.yml
    with:
      tag: ${{ needs.check.outputs.tag }}

  publish:
    name: Publish release
    needs: [check, build_linux_x86_64, build_linux_aarch64, build_windows, build_macos]
    # Publish whatever was built; one failed platform must not hold back the others.
    if: ${{ !cancelled() && needs.check.outputs.build == 'true' && (needs.build_linux_x86_64.result == 'success' || needs.build_linux_aarch64.result == 'success' || needs.build_windows.result == 'success' || needs.build_macos.result == 'success') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v8
        with:
          path: dist
          merge-multiple: true

      - name: Create or update the GitHub release
        env:
          GH_TOKEN: ${{ github.token }}
          UP_TAG: ${{ needs.check.outputs.tag }}
        run: |
          set -euo pipefail
          ver="${UP_TAG#version_}"
          ver="${ver%+boss}"
          ls -la dist
          if gh release view "${UP_TAG}-nowebview" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            gh release upload "${UP_TAG}-nowebview" dist/* --clobber --repo "$GITHUB_REPOSITORY"
          else
            gh release create "${UP_TAG}-nowebview" dist/* \
              --repo "$GITHUB_REPOSITORY" \
              --title "PrusaSlicer ${ver} (BOSS) - no Printables / Physical Printer web tabs" \
              --notes "Automated build of upstream tag \`${UP_TAG}\` from https://github.com/mjonuschat/PrusaSlicer with the Printables and Physical Printer web view tabs removed. Everything else is unchanged. See the upstream release page for the changelog. The macOS build is Apple Silicon only and is not signed or notarized: after copying it to Applications, either right-click the app and choose Open, or run \`xattr -dr com.apple.quarantine /Applications/PrusaSlicer.app\` once."
          fi

  notify_failure:
    name: Report failure
    needs: [check, build_linux_x86_64, build_linux_aarch64, build_windows, build_macos, publish]
    if: ${{ failure() && needs.check.outputs.build == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      issues: write
    steps:
      - name: Open an issue
        env:
          GH_TOKEN: ${{ github.token }}
          UP_TAG: ${{ needs.check.outputs.tag }}
          LINUX_X86_64: ${{ needs.build_linux_x86_64.result }}
          LINUX_AARCH64: ${{ needs.build_linux_aarch64.result }}
          WINDOWS: ${{ needs.build_windows.result }}
          MACOS: ${{ needs.build_macos.result }}
          PUBLISH: ${{ needs.publish.result }}
        run: |
          gh issue create --repo "$GITHUB_REPOSITORY" \
            --title "Build failed for ${UP_TAG}" \
            --body "Something failed for \`${UP_TAG}\`. Results: Linux x86_64=${LINUX_X86_64}, Linux aarch64=${LINUX_AARCH64}, Windows=${WINDOWS}, macOS=${MACOS}, publish=${PUBLISH}. Most likely the patch no longer applies to this release, or a build broke. Run: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}

          While this issue is open the daily check skips this tag. Close it (or run the workflow manually) to retry."
